# Git runs hooks from the work tree: keep them LF, or a Windows checkout with
# core.autocrlf=true breaks the shebang on the POSIX side.
/.githooks/* text eol=lf

# scripts/generate-version.mjs rewrites these four files with LF bytes on every
# `npm run dev`, `npm run build` and commit (pre-commit hook). Git for Windows
# ships core.autocrlf=true, so a plain checkout hands back CRLF copies — the LF
# rewrite then makes git list an unchanged file as modified after every run,
# forever. eol=lf keeps the checked-out bytes and the generated bytes the same.
VERSIONS.md text eol=lf
README.md text eol=lf
readme-ru.md text eol=lf
packages/shared/src/buildInfo.ts text eol=lf
