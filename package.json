{
  "name": "acpio",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "predev": "node scripts/generate-version.mjs",
    "prebuild": "node scripts/generate-version.mjs",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @acpio/server\" \"npm run dev -w @acpio/web\"",
    "dev:server": "npm run dev -w @acpio/server",
    "dev:web": "npm run dev -w @acpio/web",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "ci:protect": "node scripts/setup-branch-protection.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:desktop": "playwright test --config e2e/playwright.config.ts --project desktop",
    "test:e2e:mobile": "playwright test --config e2e/playwright.config.ts --project mobile --project mobile-small",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:report": "playwright show-report tmp/e2e/report",
    "test:e2e:gallery": "node scripts/e2e-gallery.mjs",
    "build": "npm run build -w @acpio/shared && npm run build -w @acpio/i18n && npm run build -w @acpio/plugin-api && npm run build -w @acpio/adapter-cursor && npm run build -w @acpio/adapter-omp && npm run build -w @acpio/adapter-opencode && npm run build -w @acpio/adapter-builtin && npm run build -w @acpio/plugin-ponytail && npm run build -w @acpio/server && npm run build -w @acpio/plugin-example && npm run build -w @acpio/web",
    "pack:api": "npm pack -w @acpio/plugin-api --pack-destination ./tmp",
    "postinstall": "node scripts/patch-node-pty.mjs",
    "prestart": "node scripts/ensure-built.mjs",
    "start": "npm run start -w @acpio/server",
    "dist": "node scripts/package-dist.mjs",
    "pack:npm": "node scripts/package-npm.mjs",
    "db:generate": "npm run db:generate -w @acpio/server",
    "db:migrate": "npm run db:migrate -w @acpio/server",
    "db:push": "npm run db:push -w @acpio/server",
    "screens": "node scripts/capture-screens.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "concurrently": "^9.1.2",
    "jsdom": "^28.1.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
