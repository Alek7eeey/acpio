{
  "name": "acprocess",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @acprocess/server\" \"npm run dev -w @acprocess/web\"",
    "dev:server": "npm run dev -w @acprocess/server",
    "dev:web": "npm run dev -w @acprocess/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "tts:install": "node scripts/install-piper.mjs",
    "build": "npm run build -w @acprocess/shared && npm run build -w @acprocess/i18n && npm run build -w @acprocess/server && npm run build -w @acprocess/web",
    "db:generate": "npm run db:generate -w @acprocess/server",
    "db:migrate": "npm run db:migrate -w @acprocess/server",
    "db:push": "npm run db:push -w @acprocess/server"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "concurrently": "^9.1.2",
    "jsdom": "^28.1.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
